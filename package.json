{
  "name": "skies-workspace",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "description": "Repository-level tooling for the Skies .NET, Node.js, React, and Flutter SDK workspaces.",
  "scripts": {
    "prepare": "lefthook install",
    "check:node": "npm --prefix node-sdk run check",
    "check:flutter": "npm --prefix flutter-sdk run check",
    "check:parity": "node tools/parity-guard.mjs check",
    "test:parity": "node --test tools/parity-guard.test.mjs"
  },
  "devDependencies": {
    "lefthook": "^1.10.10"
  }
}
