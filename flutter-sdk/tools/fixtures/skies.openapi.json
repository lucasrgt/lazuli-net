{
  "openapi": "3.1.1",
  "info": {
    "title": "Skies Flutter contract fixture",
    "version": "1.0.0"
  },
  "paths": {
    "/wallets": {
      "get": {
        "operationId": "ListWallets",
        "tags": ["Wallets"],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ListWalletsOutput" }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" }
              }
            }
          }
        }
      }
    },
    "/internal/health": {
      "get": {
        "operationId": "InternalHealth",
        "tags": ["skies:internal"],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InternalHealthOutput" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ListWalletsOutput": {
        "type": "object",
        "required": ["wallets"],
        "properties": {
          "wallets": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/WalletView" }
          }
        }
      },
      "WalletView": {
        "type": "object",
        "required": ["id", "balance"],
        "properties": {
          "id": { "type": "string" },
          "balance": { "type": "number", "format": "double" },
          "lastDeposit": { "type": ["number", "null"], "format": "double" }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": ["error", "code", "message", "fields"],
        "properties": {
          "error": { "type": "string" },
          "code": {
            "type": "string",
            "enum": ["wallets.not_found", "wallets.unavailable"]
          },
          "message": { "type": "string" },
          "fields": {
            "type": ["array", "null"],
            "items": { "$ref": "#/components/schemas/FieldError" }
          }
        }
      },
      "FieldError": {
        "type": "object",
        "required": ["field", "code", "message"],
        "properties": {
          "field": { "type": "string" },
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      },
      "InternalHealthOutput": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "type": "string" }
        }
      }
    }
  }
}

