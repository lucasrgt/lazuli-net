{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "runtime", "tools", "rules"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runtime": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/runtime" } },
    "tools": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tool" } },
    "ecosystemExclusives": { "type": "array", "items": { "$ref": "#/$defs/exclusive" } },
    "rules": {
      "type": "object",
      "required": ["sourcePrefix", "targetPrefix", "first", "last", "catalog", "proof"]
    }
  },
  "$defs": {
    "runtime": {
      "type": "object",
      "required": ["id", "react", "reactSource", "flutter", "source", "proof"]
    },
    "tool": {
      "type": "object",
      "required": ["id", "reactSource", "flutter", "proof"]
    },
    "exclusive": {
      "type": "object",
      "required": ["id", "react", "flutter", "proof"]
    }
  }
}
