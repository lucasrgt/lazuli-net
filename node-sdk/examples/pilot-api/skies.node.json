{
  "schemaVersion": 1,
  "git": {
    "base": "origin/main"
  },
  "criteria": [
    {
      "id": "pilot.health-openapi",
      "statement": "The live contract is healthy and client projection hides internal operations."
    },
    {
      "id": "pilot.token-issued",
      "statement": "Valid identities receive a verifiable short-lived access token and invalid input does not issue one."
    },
    {
      "id": "pilot.wallet-list",
      "statement": "Authenticated callers receive a tenant-scoped deterministically ordered bounded wallet page."
    },
    {
      "id": "pilot.storage-range",
      "statement": "Local storage streams uploads and standard byte ranges through the explicit HTTP adapter."
    }
  ],
  "lanes": [
    {
      "id": "pilot-check",
      "command": [
        "npm",
        "run",
        "check"
      ],
      "timeoutMs": 120000,
      "cwd": ".",
      "env": {
        "NODE_ENV": "test"
      }
    }
  ],
  "proofs": [
    {
      "id": "health-openapi-e2e",
      "kind": "e2e",
      "lane": "pilot-check",
      "criteria": [
        "pilot.health-openapi"
      ],
      "sourceScopes": [
        "src/app.ts",
        "src/modules.ts",
        "src/modules/wallets/health.slice.ts",
        "src/modules/wallets/health.slice.test.ts"
      ],
      "description": "Live OpenAPI and health projection proof"
    },
    {
      "id": "token-journey",
      "kind": "journey",
      "lane": "pilot-check",
      "criteria": [
        "pilot.token-issued"
      ],
      "sourceScopes": [
        "src/modules/wallets/issue-token.slice.ts",
        "src/modules/wallets/issue-token.slice.test.ts",
        "src/modules/wallets/issue-token.slice.journey.ts"
      ],
      "description": "Happy and sad token issuance journey"
    },
    {
      "id": "wallet-list-unit",
      "kind": "unit",
      "lane": "pilot-check",
      "criteria": [
        "pilot.wallet-list"
      ],
      "sourceScopes": [
        "src/modules/wallets/list-wallets.slice.ts",
        "src/modules/wallets/list-wallets.slice.test.ts",
        "src/modules/wallets/wallet*.ts",
        "database/**"
      ],
      "description": "Tenant paging and error boundary proof"
    },
    {
      "id": "storage-integration",
      "kind": "integration",
      "lane": "pilot-check",
      "criteria": [
        "pilot.storage-range"
      ],
      "sourceScopes": [
        "src/storage.http.test.ts",
        "src/app.ts",
        "src/production.ts"
      ],
      "description": "Real streaming local-storage HTTP adapter proof"
    }
  ],
  "ignoreScopes": [
    "README.md",
    ".gitignore"
  ],
  "forceFullScopes": [
    "package.json",
    "package-lock.json",
    "skies.node.json",
    "tsconfig*.json",
    "eslint.config.mjs",
    "vitest.config.ts",
    "src/modules.ts",
    "src/modules/wallets/wallets.module.ts",
    "stryker.config.mjs",
    "vitest.mutation.config.ts",
    "tools/assert-mutation.mjs"
  ]
}
