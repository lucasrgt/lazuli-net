{
  "name": "@skiesjs/testing",
  "version": "0.1.0",
  "description": "Vitest proof vocabulary and explicit real-application test host for Skies Node.js.",
  "type": "module",
  "license": "MIT",
  "author": "Lucas Tinoco",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasrgt/skies.git",
    "directory": "node-sdk/packages/testing"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./reporter": {
      "types": "./dist/reporter.d.ts",
      "import": "./dist/reporter.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --root ../.. packages/testing/src",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "vitest": ">=4 <5"
  },
  "devDependencies": {
    "vitest": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
