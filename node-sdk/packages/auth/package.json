{
  "name": "@skiesjs/auth",
  "version": "0.1.0",
  "description": "Short-lived HS256 access tokens and framework-neutral current-user verification for Skies Node.js.",
  "type": "module",
  "license": "MIT",
  "author": "Lucas Tinoco",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasrgt/skies.git",
    "directory": "node-sdk/packages/auth"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --root ../.. packages/auth/src/index.test.ts",
    "lint": "eslint src"
  },
  "dependencies": {
    "@skiesjs/core": "0.1.0",
    "jose": "^6.2.8"
  },
