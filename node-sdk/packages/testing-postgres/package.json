{
  "name": "@skiesjs/testing-postgres",
  "version": "0.1.0",
  "description": "Disposable template-cloned PostgreSQL test stores for Skies Node.js applications.",
  "type": "module",
  "license": "MIT",
  "author": "Lucas Tinoco",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasrgt/skies.git",
    "directory": "node-sdk/packages/testing-postgres"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --root ../.. packages/testing-postgres/src/index.test.ts",
    "test:integration": "vitest run --root ../.. packages/testing-postgres/src/integration.test.ts",
    "lint": "eslint src"
  },
  "dependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "postgres": "^3.4.9"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
