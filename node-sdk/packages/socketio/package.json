{
  "name": "@skiesjs/socketio",
  "version": "0.1.0",
  "description": "Explicit Socket.IO event contracts and Result acknowledgements for Skies Node.js applications.",
  "type": "module",
  "license": "MIT",
  "author": "Lucas Tinoco",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasrgt/skies.git",
    "directory": "node-sdk/packages/socketio"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run --root ../.. packages/socketio/src/index.test.ts"
  },
  "dependencies": {
    "@skiesjs/auth": "0.1.0",
    "@skiesjs/core": "0.1.0",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
