{
  "name": "@skiesjs/doctor",
  "version": "0.1.1",
  "description": "Deterministic workspace convention checks for Skies Node.js applications.",
  "type": "module",
  "license": "MIT",
  "author": "Lucas Tinoco",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasrgt/skies.git",
    "directory": "node-sdk/packages/doctor"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "skies-node-doctor": "./bin/skies-node-doctor.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --root ../.. packages/doctor/src",
    "lint": "eslint src bin"
  },
  "dependencies": {
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
