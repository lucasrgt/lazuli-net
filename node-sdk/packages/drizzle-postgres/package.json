{
  "name": "@skiesjs/drizzle-postgres",
  "version": "0.1.0",
  "description": "Narrow ordered Drizzle/PostgreSQL pagination for Skies Node.js applications.",
  "type": "module",
  "license": "MIT",
  "author": "Lucas Tinoco",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasrgt/skies.git",
    "directory": "node-sdk/packages/drizzle-postgres"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --root ../.. packages/drizzle-postgres/src/index.test.ts",
    "lint": "eslint src"
  },
  "dependencies": {
    "@skiesjs/core": "0.1.0"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "devDependencies": {
    "@skiesjs/testing-postgres": "0.1.0",
    "vitest": "^4.0.0"
  }
}
