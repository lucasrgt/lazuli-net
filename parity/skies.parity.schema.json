{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skies.dev/schemas/skies.parity.schema.json",
  "title": "Skies cross-runtime parity manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "policy",
    "sharedContracts",
    "capabilities",
    "diagnostics",
    "deferments"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "behaviorPatterns",
        "ignoredBehavior"
      ],
      "properties": {
        "behaviorPatterns": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dotnet",
            "node"
          ],
          "properties": {
            "dotnet": {
              "$ref": "#/$defs/nonEmptyStrings"
            },
            "node": {
              "$ref": "#/$defs/nonEmptyStrings"
            }
          }
        },
        "ignoredBehavior": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sharedContracts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sharedContract"
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "deferments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/deferment"
      }
    },
    "diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path"
      ],
      "properties": {
        "kind": {
          "enum": [
            "build",
            "doctor",
            "integration",
            "journey",
            "mutation",
            "package-smoke",
            "test",
            "wire-fixture"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "side": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scopes",
        "proofs"
      ],
      "properties": {
        "scopes": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "proofs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/proof"
          }
        }
      }
    },
    "sharedContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "consumers"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "consumers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dotnet",
            "node"
          ],
          "properties": {
            "dotnet": {
              "$ref": "#/$defs/nonEmptyStrings"
            },
            "node": {
              "$ref": "#/$defs/nonEmptyStrings"
            }
          }
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "parity",
        "dotnet",
        "node",
        "sharedContracts"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "parity": {
          "enum": [
            "adapter-specific",
            "equivalent",
            "wire-compatible"
          ]
        },
        "dotnet": {
          "$ref": "#/$defs/side"
        },
        "node": {
          "$ref": "#/$defs/side"
        },
        "sharedContracts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "deferment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "capability",
        "side",
        "reason",
        "owner",
        "expires"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "side": {
          "enum": [
            "dotnet",
            "node"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "expires": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dotnet",
        "node",
        "capability"
      ],
      "properties": {
        "dotnet": {
          "type": "string",
          "pattern": "^SKY[0-9]{4}$"
        },
        "node": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "enum": [
                "diagnostic",
                "explicit-api",
                "generator",
                "language"
              ]
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "capability": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        }
      }
    }
  }
}
